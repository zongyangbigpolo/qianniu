    ./deploy.sh help           # 查看所有命令
    ./deploy.sh build          # 构建 JAR 包
    ./deploy.sh up             # 启动所有服务
    ./deploy.sh status         # 查看服务状态
    ./deploy.sh logs -s server # 查看后端日志

