# ============================================================
# 千牛 生产环境部署配置（配合 docker-compose.prod.yml 使用）
# 使用方法：cp .env.prod.example .env 然后修改下面的值
# ============================================================

# --- 镜像来源（GitHub Actions 构建并推送到 GHCR）---
# main 分支镜像，也可以改成具体版本，例如 v1.0.0
SERVER_IMAGE=ghcr.io/zongyangbigpolo/qianniu-server:main
ADMIN_IMAGE=ghcr.io/zongyangbigpolo/qianniu-admin:main

# --- MySQL（务必修改为强密码）---
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

MASTER_DATASOURCE_URL=jdbc:mysql://qianniu-mysql:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SLAVE_DATASOURCE_URL=jdbc:mysql://qianniu-mysql:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
SLAVE_DATASOURCE_USERNAME=root
SLAVE_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_HOST=qianniu-redis

# --- JVM ---
# 轻量服务器（2C4G）建议保持默认；如果内存更小，可调低为 -Xms256m -Xmx256m
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom
