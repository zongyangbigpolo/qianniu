# ============================================================
# Docker 环境变量配置文件
# 复制本文件为 .env 并修改相应的值
# ============================================================

# MySQL 配置
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=123456

# 数据源配置（主库）
MASTER_DATASOURCE_URL=jdbc:mysql://yudao-mysql:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=123456

# 数据源配置（从库，可选）
SLAVE_DATASOURCE_URL=jdbc:mysql://yudao-mysql:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
SLAVE_DATASOURCE_USERNAME=root
SLAVE_DATASOURCE_PASSWORD=123456

# Redis 配置
REDIS_HOST=yudao-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Java 虚拟机配置
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom

# Spring 配置
SPRING_PROFILES_ACTIVE=local

# 前端配置
NODE_ENV=production
PUBLIC_PATH=/
VUE_APP_TITLE=千牛管理系统
VUE_APP_BASE_API=/prod-api
VUE_APP_APP_NAME=/
VUE_APP_TENANT_ENABLE=true
VUE_APP_CAPTCHA_ENABLE=true
VUE_APP_DOC_ENABLE=true
VUE_APP_BAIDU_CODE=fadc1bd5db1a1d6f581df60a1807f8ab

# ============================================================
# 生产环境建议修改以下值：
# 1. 修改 MYSQL_ROOT_PASSWORD 为强密码
# 2. 修改 MASTER_DATASOURCE_PASSWORD 为强密码
# 3. 修改 REDIS_PASSWORD（如果需要）
# 4. 修改 JAVA_OPTS 中的内存配置（根据服务器配置）
# ============================================================
