# Docker 部署环境：构建时使用，运行在 Nginx 容器内，API 由 Nginx 反向代理到后端容器
NODE_ENV=production

VITE_DEV=false

# 留空，配合 Nginx 反向代理使用相对路径，避免硬编码 localhost
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 是否开启压缩
VITE_COMPRESS=none

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist

# 商城H5会员端域名
VITE_MALL_H5_DOMAIN=''

# GoView域名
VITE_GOVIEW_URL=''
